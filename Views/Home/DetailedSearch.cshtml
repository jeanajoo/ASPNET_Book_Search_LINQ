@model Joo_Jeana_HW3.Models.SearchViewModel

@{
    ViewData["Title"] = "Detailed Search";
}

<!DOCTYPE html>

<html>
    <meta name="viewport" content="width=device-width" />
    <title>DetailedSearch</title>

<h4>SearchViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="DisplaySearchResults" method="get">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="SearchName" class="control-label"></label>
                <input asp-for="SearchName" class="form-control" />
                <span asp-validation-for="SearchName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SearchDescription" class="control-label"></label>
                <input asp-for="SearchDescription" class="form-control" />
                <span asp-validation-for="SearchDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SearchFormat" class="control-label">Book Format:</label>
                @Html.DropDownList("SearchFormat", Html.GetEnumSelectList<Joo_Jeana_HW3.Models.Format>(), "All Formats", new { @class = "form-control" })
                <span asp-validation-for="SearchFormat" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Genre:</label>
                @Html.DropDownList("SelectedGenreID", (SelectList)ViewBag.AllGenres, new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label asp-for="SearchPrice" class="control-label"></label>
                <input asp-for="SearchPrice" class="form-control" />
                <span asp-validation-for="SearchPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Search Type (for Price):</label><br />
                <div class="form-check form-check-inline">
                    @* The 'value' must match the strings you check for in your Controller *@
                    <input class="form-check-input" type="radio" name="PriceType" value="GreaterThan" checked />
                    <label class="form-check-label">Greater Than</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="PriceType" value="LessThan" />
                    <label class="form-check-label">Less Than</label>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="SearchDate" class="control-label"></label>
                <input asp-for="SearchDate" class="form-control" />
                <span asp-validation-for="SearchDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Search" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
</html>
